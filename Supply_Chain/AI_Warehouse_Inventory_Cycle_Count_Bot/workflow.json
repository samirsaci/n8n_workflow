            "webhookId": "59443d8d-8334-4815-8d3d-6441d717cf9e",
            "parameters": {
                "text": "=📦 *LogiGreen Inventory Cycle Count AI Assistant — Help*\n\nWelcome! I will assist you step by step during your cycle count using voice commands.\n\n*Available commands:*  \n/start — Begin the cycle count  \n/help — Display this help message\n\n*How it works:*  \nI will send you one location at a time.  \nOnce you reach it, please send a *voice message* stating:  \n- the location  \n- the number of units counted\n\n*If something is unclear:*  \nI will inform you if your message cannot be understood, if the location does not exist, or if it has already been counted.\n\n*End of process:*  \nYou will receive a confirmation message when all locations have been processed.",
                "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
                "additionalFields": {
                    "parse_mode": "Markdown",
                    "appendAttribution": false
                }
            },
            "credentials": {
                "telegramApi": {
                    "id": "",
                    "name": ""
                }
